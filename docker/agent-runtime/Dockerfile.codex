# syntax=docker/dockerfile:1.6
ARG BASE_TAG=dev
ARG BASE_IMAGE=paperclipai/agent-runtime-base:${BASE_TAG}
FROM ${BASE_IMAGE}

ARG CODEX_VERSION=0.164.0

USER root
RUN printf '%s\n' "$CODEX_VERSION" | grep -Ex '[0-9]+\.[0-9]+\.[0-9]+' \
    && npm install -g @openai/codex@"$CODEX_VERSION" \
    && chown -R 1000:1000 /usr/lib/node_modules

USER 1000:1000

# Verify the CLI is on PATH for the shim's exec.LookPath
RUN command -v codex >/dev/null 2>&1 || (echo "codex not on PATH"; exit 1)

LABEL io.paperclip.codex.version=$CODEX_VERSION
RUN --network=none codex --version | grep -Fx "codex-cli $CODEX_VERSION"
